{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blue-vue",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "BLUEVUE_SIMULATE": "1"
      },
      "port": 3000
    },
    {
      "name": "blue-vue-live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "env": {
        "BLUEVUE_DATA": "data/live",
        "BLUEVUE_PYTHON": ".venv/bin/python"
      },
      "port": 3000
    },
    {
      "name": "blue-vue-mosaic-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "env": {
        "BLUEVUE_SIMULATE": "1",
        "BLUEVUE_DATA": "data/demo"
      },
      "port": 3000
    }
  ]
}
