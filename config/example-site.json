  "scenes": [
    {
      "id": "open",
      "name": "Open Venue",
      "description": "Walls on, full layout, ESPN on Box 1, house audio",
      "steps": [
        {
          "type": "command",
          "group": "wall1",
          "command": "power_on",
          "params": {}
        },
        {
          "type": "command",
          "group": "wall2",
          "command": "power_on",
          "params": {}
        },
        {
          "type": "delay",
          "ms": 8000
        },
        {
          "type": "command",
          "device": "mosaic",
          "command": "recall_preset",
          "params": {
            "group": "main-wall",
            "preset": "camera-1-full",
            "transitionMs": 500
          }
        },
        {
          "type": "command",
          "device": "box1",
          "command": "tune",
          "params": {
            "channel": 206
          }
        },
        {
          "type": "command",
          "device": "atlas",
          "command": "set_source",
          "params": {
            "zone": 0,
            "source": 0
          }
        },
        {
          "type": "command",
          "device": "atlas",
          "command": "set_gain",
          "params": {
            "zone": 0,
            "db": -25
          }
        },
        {
          "type": "command",
          "device": "atlas",
          "command": "set_mute",
          "params": {
            "zone": 0,
            "mute": false
          }
        }
      ]
    },
    {
      "id": "gameday",
      "name": "Game Day",
      "description": "Quad layout across three sports channels",
      "steps": [
        {
          "type": "command",
          "device": "mosaic",
          "command": "recall_preset",
          "params": {
            "group": "main-wall",
            "preset": "quad",
            "transitionMs": 500
          }
        },
        {
          "type": "command",
          "device": "box1",
          "command": "tune",
          "params": {
            "channel": 206
          }
        },
        {
          "type": "command",
          "device": "box2",
          "command": "tune",
          "params": {
            "channel": 225
          }
        },
        {
          "type": "command",
          "device": "box3",
          "command": "tune",
          "params": {
            "channel": 241
          }
        },
        {
          "type": "command",
          "device": "atlas",
          "command": "recall_scene",
          "params": {
            "scene": 1
          }
        }
      ]
    },
    {
      "id": "close",
      "name": "Close Venue",
      "description": "Mute all zones and power off every wall",
      "steps": [
        {
          "type": "command",
          "device": "atlas",
          "command": "set_mute",
          "params": {
            "zone": 0,
            "mute": true
          }
        },
        {
          "type": "command",
          "device": "atlas",
          "command": "set_mute",
          "params": {
            "zone": 1,
            "mute": true
          }
        },
        {
          "type": "command",
          "device": "atlas",
          "command": "set_mute",
          "params": {
            "zone": 2,
            "mute": true
          }
        },
        {
          "type": "command",
          "group": "wall1",
          "command": "power_off",
          "params": {}
        },
        {
          "type": "command",
          "group": "wall2",
          "command": "power_off",
          "params": {}
        }
      ]
    }
