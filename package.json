{
  "name": "blue-vue",
  "version": "0.1.0",
  "private": true,
  "description": "AV control system: IR video wall power, Xfinity tuning, TV guide, Atlas IED DSP, video wall presets",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test test/engine/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "gracenote": "tsx src/tools/gracenote.ts",
    "build": "vite build web",
    "dev:web": "vite web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.6",
    "fastify": "^5.12.7",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.10"
  }
}
